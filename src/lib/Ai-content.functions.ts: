import { createServerFn } from "@tanstack/react-start";

type GenerateContentInput = {
  type: "description" | "instagram";
  productName: string;
  category?: string;
  price: number;
  description?: string;
};

export const generateAiContent = createServerFn({ method: "POST" }).handler(
  async ({ data }: { data: GenerateContentInput }) => {
    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey) throw new Error("مفتاح Gemini غير موجود");

    let prompt = "";
    if (data.type === "description") {
      prompt = `اكتب وصف تسويقي جذاب لمنتج عناية بالسيارات باللغة العربية.
اسم المنتج: ${data.productName}
القسم: ${data.category || "غير محدد"}
السعر: ${data.price} ريال يمني
الوصف يجب أن يكون فقرة واحدة قصيرة (2-3 جمل)، احترافي، يبرز فوائد المنتج دون مبالغة. أعد النص فقط بدون أي مقدمات.`;
    } else {
      prompt = `اكتب منشور انستغرام لمنتج عناية بالسيارات باللغة العربية.
اسم المنتج: ${data.productName}
الوصف: ${data.description || ""}
السعر: ${data.price} ريال يمني

المنشور يجب أن يحتوي:
- عنوان جذاب مع إيموجيات
- تفاصيل المنتج والسعر
- عبارة "للطلب والتواصل عبر الواتساب أو الخاص"
- هاشتاقات: #زين_أصل_الحماية #صنعاء #عناية_بالسيارات #سيارات_اليمن

أعد النص فقط بدون أي مقدمات.`;
    }

    const res = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }],
        }),
      }
    );

    if (!res.ok) {
      throw new Error("فشل الاتصال بـ Gemini، حاول مرة أخرى");
    }

    const json = await res.json();
    const text = json?.candidates?.[0]?.content?.parts?.[0]?.text ?? "";

    if (!text) {
      throw new Error("لم يتم توليد أي نص، حاول مرة أخرى");
    }

    return { text: text.trim() };
  }
);
